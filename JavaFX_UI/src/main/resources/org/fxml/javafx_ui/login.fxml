<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <!-- LEFT SIDE: LOGIN BACKGROUND -->
        <Rectangle fill="WHITE" height="400.0" layoutX="0.0" layoutY="0.0" stroke="TRANSPARENT" width="300.0" />

        <!-- RIGHT SIDE: REGISTER BACKGROUND -->
        <Rectangle fill="#79a3c9" height="401.0" layoutX="281.0" layoutY="0.0" stroke="TRANSPARENT" width="320.0" />

        <!-- FLIGHTSYNC LOGO -->
        <ImageView fitHeight="162.0" fitWidth="243.0" layoutX="13.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">

            <image>
                <Image url="@../../../images/Flightsync.png" />
            </image>

        </ImageView>

        <!-- LOGIN SECTION -->

        <Label layoutX="30.0" layoutY="136.0" text="Sign In">

            <font>
                <Font name="Big Caslon Medium" size="24.0" />
            </font>

        </Label>

        <Label layoutX="60.0" layoutY="102.0" prefHeight="17.0" prefWidth="176.0" text="Log in to manage your flights and reservations.">

            <font>
                <Font name="Big Caslon Medium" size="9.0" />
            </font>

        </Label>

        <Label layoutX="29.0" layoutY="172.0" text="Username">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Label>

        <TextField layoutX="28.0" layoutY="190.0" prefHeight="26.0" prefWidth="183.0" promptText="Enter username" />

        <Label layoutX="30.0" layoutY="230.0" text="Password">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Label>

        <PasswordField layoutX="28.0" layoutY="248.0" prefHeight="26.0" prefWidth="183.0" promptText="Enter password" />

        <CheckBox layoutX="30.0" layoutY="285.0" mnemonicParsing="false" style="-fx-background-color: #ffffff;" text="Remember me">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </CheckBox>

        <Button alignment="CENTER" layoutX="72.0" layoutY="319.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="119.0" style="-fx-background-radius: 20; -fx-background-color: #79a3c9;" text="Login" textAlignment="CENTER" textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Button>

        <!-- REGISTRATION SECTION -->

        <Label layoutX="309.0" layoutY="24.0" text="Register" textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="24.0" />
            </font>

        </Label>

        <Label layoutX="305.0" layoutY="54.0" prefHeight="17.0" prefWidth="243.0" text="Create an account and start exploring today." textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="10.0" />
            </font>

        </Label>

        <!-- FIRST NAME -->

        <Label layoutX="309.0" layoutY="81.0" text="First Name" textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Label>

        <TextField layoutX="305.0" layoutY="99.0" prefHeight="26.0" prefWidth="130.0" promptText="First name" style="-fx-background-color: #ffffff;" />

        <!-- LAST NAME -->

        <Label layoutX="452.0" layoutY="81.0" text="Last Name" textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Label>

        <TextField layoutX="450.0" layoutY="99.0" prefHeight="26.0" prefWidth="130.0" promptText="Last name" style="-fx-background-color: #ffffff;" />

        <!-- EMAIL -->

        <Label layoutX="309.0" layoutY="130.0" text="Email" textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Label>

        <TextField layoutX="305.0" layoutY="147.0" prefHeight="26.0" prefWidth="275.0" promptText="Enter your email" style="-fx-background-color: #ffffff;" />

        <!-- PHONE -->

        <Label layoutX="309.0" layoutY="179.0" text="Phone" textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Label>

        <TextField layoutX="305.0" layoutY="197.0" prefHeight="26.0" prefWidth="275.0" promptText="Enter phone number" style="-fx-background-color: #ffffff;" />

        <!-- PASSWORD -->

        <Label layoutX="309.0" layoutY="227.0" text="Password" textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Label>

        <PasswordField layoutX="305.0" layoutY="249.0" prefHeight="26.0" prefWidth="275.0" promptText="Create a password" style="-fx-background-color: #ffffff;" />

        <!-- CONFIRM PASSWORD -->

        <Label layoutX="309.0" layoutY="282.0" text="Confirm Password" textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Label>

        <PasswordField layoutX="305.0" layoutY="300.0" prefHeight="26.0" prefWidth="275.0" promptText="Confirm password" style="-fx-background-color: #ffffff;" />

        <!-- TERMS AND CONDITIONS -->

        <CheckBox layoutX="305.0" layoutY="334.0" mnemonicParsing="false" text="I agree to the Terms and Conditions" textFill="WHITE">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </CheckBox>

        <!-- CREATE ACCOUNT BUTTON -->

        <Button alignment="CENTER" layoutX="350.0" layoutY="359.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="200.0" style="-fx-background-radius: 20; -fx-background-color: #ffffff;" text="Create Account" textAlignment="CENTER" textFill="#79a3c9">

            <font>
                <Font name="Big Caslon Medium" size="13.0" />
            </font>

        </Button>

    </children>

</AnchorPane>
