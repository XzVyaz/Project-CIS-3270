<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: WHITE;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="org.example.javafx_ui.LoginController">


<children>

        <Label layoutX="215.0" layoutY="105.0" style="-fx-font-size: 26px;                       -fx-font-weight: bold;" text="Welcome Back!">
         <font>
            <Font name="Big Caslon Medium" size="13.0" />
         </font></Label>

        <TextField fx:id="usernameField" layoutX="175" layoutY="145" prefWidth="250" promptText="Username" />

        <PasswordField fx:id="passwordField" layoutX="175" layoutY="190" prefWidth="250" promptText="Password" />

        <Button layoutX="175" layoutY="245" onAction="#handleLogin" prefWidth="250" style="-fx-background-color: #79a3c9;                        -fx-text-fill: white;" text="Login" />

        <Button layoutX="175" layoutY="290" onAction="#goToRegister" prefWidth="250" text="Don't have an account? Register" />

        <Button layoutX="225" layoutY="330" onAction="#goToForgotPassword" prefWidth="150" text="Forgot Password?" />
      <ImageView fitHeight="120.0" fitWidth="267.0" layoutX="158.0" layoutY="24.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/LOGO.png" />
         </image>
      </ImageView>

    </children>
</AnchorPane>
